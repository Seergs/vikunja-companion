# Copy to .env for local `go run` / `make run-companion` (auto-loaded, never
# overrides a real env var). The paths below are the in-container defaults — for
# local dev point COMPANION_DB_PATH at a relative path like ./data/companion.db

# Public HTTPS base URL of this companion. Used verbatim as the Vikunja webhook
# target_url, so Vikunja must be able to reach it. Required.
COMPANION_PUBLIC_URL=https://companion.example.com

# The real Vikunja instance the proxy forwards /api/v1/* to. Required.
VIKUNJA_UPSTREAM_URL=https://vikunja.example.com

# 32-byte key, base64 or hex, encrypting the webhook HMAC secret at rest.
# Generate: openssl rand -hex 32     Required.
COMPANION_MASTER_KEY=

# Listen address and SQLite path. Local dev: COMPANION_DB_PATH=./data/companion.db
COMPANION_LISTEN_ADDR=:8080
COMPANION_DB_PATH=/data/companion.db

# Vikunja webhook events the companion accepts. Operator ceiling — per-user
# prefs are intersected with this.
COMPANION_WEBHOOK_EVENTS=task.reminder.fired,task.overdue,tasks.overdue

# Vikunja API token the morning-digest cron acts as. Single-user in v1; unset
# disables the digest (the webhook path does not need it). Needs the token's
# `tasks` read + `other` permission groups.
# COMPANION_VIKUNJA_TOKEN=

# Morning-briefing cron kill switch (default on). Only fires when
# COMPANION_VIKUNJA_TOKEN is set; the user's time/enable come from the iOS app.
COMPANION_DIGEST_ENABLED=true

# Notification delivery via Apprise (apprise-api). Unset -> notifications are
# logged, not sent. See docs/COMPANION.md 6.5.
#   API_URL: .../notify/<key> (config saved in apprise-api) or .../notify (+ URLS)
#   URLS:    comma-separated Apprise service URLs, for the .../notify form
#   TOKEN:   sent as Authorization: Bearer to the endpoint
# COMPANION_APPRISE_API_URL=https://apprise.example.com/notify
# COMPANION_APPRISE_URLS=ntfy://ntfy.sh/my-topic
# COMPANION_APPRISE_TOKEN=

COMPANION_LOG_LEVEL=info
