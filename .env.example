# Copy to .env for local `go run` / `make run-*` (auto-loaded, never overrides a
# real env var). The paths below are the in-container defaults — for local dev
# point COMPANION_DB_PATH / RELAY_DB_PATH at a relative path like ./data/…
#
# ─────────────────────────────────────────────────────────────────────────────
# companion (cmd/companion)
# ─────────────────────────────────────────────────────────────────────────────

# Public HTTPS base URL of this companion. Used verbatim as the Vikunja webhook
# target_url, so Vikunja must be able to reach it. Required.
COMPANION_PUBLIC_URL=https://companion.example.com

# The real Vikunja instance the proxy forwards /api/v1/* to. Required.
VIKUNJA_UPSTREAM_URL=https://vikunja.example.com

# 32-byte key, base64 or hex, encrypting stored Vikunja API tokens at rest.
# Generate: openssl rand -hex 32       Required.
COMPANION_MASTER_KEY=

# Listen address and SQLite path. Local dev: COMPANION_DB_PATH=./data/companion.db
COMPANION_LISTEN_ADDR=:8080
COMPANION_DB_PATH=/data/companion.db

# Content-blind push relay. Defaults to the project-operated relay; the token is
# auto-registered on first boot if left unset.
# COMPANION_RELAY_URL=https://relay.vikunja-companion.example
# COMPANION_RELAY_TOKEN=

# v1 push surface. Operator ceiling — per-user prefs are intersected with this.
COMPANION_WEBHOOK_EVENTS=task.reminder.fired,task.overdue,tasks.overdue

# Bring-your-own APNs (self-hosted push, bypasses the relay). All four together.
# COMPANION_APNS_KEY_PATH=/keys/AuthKey.p8
# COMPANION_APNS_KEY_ID=
# COMPANION_APNS_TEAM_ID=
# COMPANION_APNS_TOPIC=com.example.vikunja

COMPANION_LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────────
# relay (cmd/relay) — maintainer-operated only
# ─────────────────────────────────────────────────────────────────────────────

# RELAY_APNS_KEY_PATH=/keys/AuthKey.p8
# RELAY_APNS_KEY_ID=
# RELAY_APNS_TEAM_ID=
# RELAY_APNS_TOPIC=com.example.vikunja
# RELAY_APNS_SANDBOX=false          # true -> APNs sandbox gateway (dev builds)
# RELAY_LISTEN_ADDR=:8081
# RELAY_DB_PATH=/data/relay.db      # local dev: ./data/relay.db
# RELAY_LOG_LEVEL=info
